# Neon connection (asyncpg driver; keep TLS enabled with ssl=require)
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-000000.eu-central-1.aws.neon.tech/neondb?ssl=require

# JWT settings
JWT_SECRET=your-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

TEST_DATABASE_URL=postgresql+asyncpg://test:test@localhost:5433/task_tracker_test
